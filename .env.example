# Copy to .env locally and fill in credentials. Never commit populated .env files.
JUDGE_API_KEY=
JUDGE_API_BASE_URL=https://api.openai.com/v1
FREAK_DATASET_ID=

# Optional training overrides. Dataset files are not included in this repository.
MODEL_PATH=Qwen/Qwen2.5-VL-7B-Instruct
RM_MODEL_PATH=Qwen/Qwen3-VL-32B-Instruct
TRAIN_FILE=
VAL_FILE=

# Optional data-construction deployment; required by build_training_data.py.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Optional training resource/logging overrides.
N_GPUS=8
TRAINER_LOGGER=[console]
